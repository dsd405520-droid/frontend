# Backend API origin (no trailing slash).
# DEV: leave empty to use the Vite dev proxy (relative /api).
# PROD: set to the public backend URL, e.g. https://api.example.com
VITE_API_URL=

# Public base URL used to build QR links (asset QR, supply receipt QR).
# Must be reachable from phones. Leave empty to fall back to window.location.origin.
# e.g. https://portal.example.com  or  http://10.4.9.9:5173
VITE_PUBLIC_BASE_URL=
